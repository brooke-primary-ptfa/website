{
	"name": "brooke-ptfa-website",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vite build && vitest run",
		"deploy:preview": "npm test && firebase hosting:channel:deploy preview --expires 30d",
		"deploy:live": "npm test && firebase deploy --only hosting"
	},
	"devDependencies": {
		"@lucide/svelte": "^1.57.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"firebase-tools": "^15.34.0",
		"node-html-parser": "^9.0.4",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.4"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
